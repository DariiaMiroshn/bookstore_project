[flake8]
max-line-length = 120
exclude =
    .git,
    __pycache__,
    */migrations/*,
    .venv,
    venv,
    staticfiles,
    media
ignore = E203, W503
per-file-ignores =
    bookstore/settings/*: F401, F403
    warehouse_service/config/settings/*: F401, F403, F405
    */tests/*: F401
    */test_*.py: F401
    store/views.py: F401